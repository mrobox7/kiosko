  "components": {
    "schemas": {
      "AvailabilityOut": {
        "properties": {
          "slot_datetime": {
            "type": "string",
            "format": "date-time",
            "title": "Slot Datetime"
          },
          "party_size": { "type": "integer", "title": "Party Size" },
