            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Special Requests"
          }
        },
        "type": "object",
        "required": ["customer_id", "table_id", "slot_datetime", "party_size"],
        "title": "ReservationCreate"
      },
