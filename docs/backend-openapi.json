        "type": "object",
        "required": ["slot_datetime", "party_size", "available_tables"],
        "title": "AvailabilityOut"
      },
      "AvailableTable": {
        "properties": {
          "table_id": { "type": "integer", "title": "Table Id" },
          "table_number": { "type": "integer", "title": "Table Number" },
          "capacity": { "type": "integer", "title": "Capacity" },
          "location": { "type": "string", "title": "Location" }
        },
        "type": "object",
        "required": ["table_id", "table_number", "capacity", "location"],
        "title": "AvailableTable"
      },
      "CustomerCreate": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "phone": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Phone"
          },
          "email": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Email"
          },
          "preferences": { "type": "object", "title": "Preferences" }
        },
        "type": "object",
        "required": ["name"],
        "title": "CustomerCreate"
      },
      "CustomerOut": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "phone": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Phone"
          },
          "email": {
            "anyOf": [{ "type": "string" }, { "type": "null" }],
            "title": "Email"
          },
          "preferences": { "type": "object", "title": "Preferences" },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "phone",
          "email",
          "preferences",
          "created_at"
        ],
        "title": "CustomerOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MenuItemOut": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "name": { "type": "string", "title": "Name" },
          "description": { "type": "string", "title": "Description" },
          "price": { "type": "number", "title": "Price" },
          "tags": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Tags"
          },
          "category": {
            "type": "string",
            "enum": ["starter", "main", "dessert"],
            "title": "Category"
          },
          "available": { "type": "boolean", "title": "Available" }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "price",
          "tags",
          "category",
          "available"
        ],
        "title": "MenuItemOut"
      },
      "OrderCreate": {
        "properties": {
          "menu_item_id": { "type": "integer", "title": "Menu Item Id" },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "type": "object",
        "required": ["menu_item_id"],
        "title": "OrderCreate"
      },
      "OrderOut": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "reservation_id": { "type": "integer", "title": "Reservation Id" },
          "menu_item_id": { "type": "integer", "title": "Menu Item Id" },
